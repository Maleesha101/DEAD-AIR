# Copy to .env for local development. Never commit .env.
# Do not put real credentials or production secrets here.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Replace with a deployment-specific random value before running a completed lab.
# This placeholder is NOT a valid production secret.
FLAG_SIGNING_SECRET=change-me-before-use
CAMPAIGN_FLAG=FLAG{replace_with_unique_local_flag}

# Keep services local during development. Do not expose vulnerable services publicly.
